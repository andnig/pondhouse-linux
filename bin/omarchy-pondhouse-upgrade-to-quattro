#!/bin/bash

# omarchy:summary=Upgrade Pondhouse Omarchy 3 to package-backed Quattro
# omarchy:group=pondhouse
# omarchy:name=upgrade-to-quattro
# omarchy:args=[--dry-run] [--yes] [--resume RUN-DIRECTORY]
# omarchy:examples=omarchy pondhouse upgrade-to-quattro --dry-run

set -euo pipefail
umask 077

UPGRADER_URL=${PONDHOUSE_UPGRADER_URL:-https://raw.githubusercontent.com/basecamp/omarchy/f0020448ca87329199de7cb12f2015ebc4a3e5e7/bin/omarchy-upgrade-to-quattro}
UPGRADER_SHA256=${PONDHOUSE_UPGRADER_SHA256:-fd5f311313c87bf25429220a3c4e65da755ee0c2e78648a20e30e86133495fd4}
PACKAGE_VERSION=${PONDHOUSE_PACKAGE_VERSION:-2026.08.15-15}
KEYRING_VERSION=${PONDHOUSE_KEYRING_VERSION:-2026.08.15-1}
KEYRING_SHA256=${PONDHOUSE_KEYRING_SHA256:-3f08cbadc45c8a229780ad5641a7f0afee6f1e16835422cca81ab856948580c0}
PACKAGE_SHA256=${PONDHOUSE_PACKAGE_SHA256:-8cf5d0a6f0e34796953ee8c46a936a729ad9e388a88af997928c0d51d2d5da1d}
REPOSITORY_SHA256=${PONDHOUSE_REPOSITORY_SHA256:-0bfaef463b2700f28252519e65c5c737f97efffc1266fc67acc6098298651f11}
SIGNING_FINGERPRINT=${PONDHOUSE_SIGNING_FINGERPRINT:-2E4DE2E86D2D5D4EF994B0A849EE396C83FEEC69}
SNAPSHOT_URL=${PONDHOUSE_SNAPSHOT_URL:-https://packages.pondhouse-data.com/snapshots/$PACKAGE_VERSION/x86_64}
STABLE_URL=${PONDHOUSE_STABLE_URL:-https://packages.pondhouse-data.com/stable/\$arch}
LEGACY_ROOT=${PONDHOUSE_LEGACY_ROOT:-$HOME/.local/share/omarchy}
STATE_BASE=${PONDHOUSE_MIGRATION_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/pondhouse/quattro-migrations}
BACKUP_BASE=${PONDHOUSE_MIGRATION_BACKUPS:-${XDG_DATA_HOME:-$HOME/.local/share}/pondhouse/backups/quattro-migrations}
QUATTRO_ROOT=${PONDHOUSE_QUATTRO_ROOT:-/usr/share/omarchy}
PACMAN_CONFIG=${PONDHOUSE_PACMAN_CONFIG:-/etc/pacman.conf}
PACMAN_KEYRING_DIR=${PONDHOUSE_PACMAN_KEYRING_DIR:-/usr/share/pacman/keyrings}
DRY_RUN=0
YES=0
RUN_DIR=""
PROTECTED_AGENT_PATHS=(.claude .codex .pi)

usage() {
  cat <<'EOF'
Usage: omarchy-pondhouse-upgrade-to-quattro [--dry-run] [--yes] [--resume RUN-DIRECTORY]

Preserve a checkout-backed Pondhouse Omarchy 3 installation, run Basecamp's
checksum-pinned Quattro upgrader, and install the released Pondhouse package.

Options:
  --dry-run         Record and display the migration inventory only
  --yes             Skip the confirmation prompt
  --resume RUN-DIR  Resume an interrupted migration from its private state
  -h, --help        Show this help
EOF
}

while (( $# )); do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    -y|--yes) YES=1 ;;
    --resume)
      (( $# >= 2 )) || { echo "--resume requires a run directory" >&2; exit 2; }
      RUN_DIR=$2
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if (( EUID == 0 )); then
  echo "Run this migration as the employee; it uses sudo only for machine changes" >&2
  exit 1
fi

[[ -e $LEGACY_ROOT ]] && LEGACY_ROOT=$(readlink -f -- "$LEGACY_ROOT")

phase_done() {
  [[ -f $RUN_DIR/phases/$1 ]]
}

mark_phase() {
  printf '%s\n' "$(date --iso-8601=seconds)" >"$RUN_DIR/phases/$1"
}

is_excluded() {
  local path=$1 protected
  for protected in "${PROTECTED_AGENT_PATHS[@]}"; do
    [[ $path == "$HOME/$protected" || $path == "$HOME/$protected"/* ]] && return 0
  done
  [[ $path == */backup || $path == */backup/* ||
    $path == */backups || $path == */backups/* ||
    $path == */*_bkp || $path == */*_bkp/* ]]
}

points_into_legacy_root() {
  local resolved
  resolved=$(readlink -f -- "$1" 2>/dev/null || true)
  [[ -n $resolved && ( $resolved == "$LEGACY_ROOT" || $resolved == "$LEGACY_ROOT"/* ) ]]
}

scan_roots() {
  local roots=("$HOME/.config")
  local path opencode_config=${OPENCODE_CONFIG:-$HOME/.config/opencode}

  for path in "$HOME/.agents" "$opencode_config" "$HOME/.ssh" "$HOME/scripts" "$HOME/source" "$HOME/.zshrc"; do
    [[ -e $path || -L $path ]] && roots+=("$path")
  done
  printf '%s\0' "${roots[@]}" | sort -zu
}

find_legacy_links() {
  local root path

  while IFS= read -r -d '' root; do
    [[ -e $root || -L $root ]] || continue
    if [[ -L $root ]] && ! is_excluded "$root" && points_into_legacy_root "$root"; then
      printf '%s\0' "$root"
    fi
    while IFS= read -r -d '' path; do
      is_excluded "$path" && continue
      points_into_legacy_root "$path" && printf '%s\0' "$path"
    done < <(find -H "$root" -type l -print0 2>/dev/null)
  done < <(scan_roots) | sort -zu
}

write_command_output() {
  local destination=$1
  shift
  "$@" >"$destination" 2>&1 || true
}

write_git_inventory() {
  [[ -d $LEGACY_ROOT/.git ]] || return 0

  write_command_output "$RUN_DIR/inventory/legacy-commit.txt" git -C "$LEGACY_ROOT" rev-parse HEAD
  write_command_output "$RUN_DIR/inventory/legacy-branch.txt" git -C "$LEGACY_ROOT" branch --show-current
  write_command_output "$RUN_DIR/inventory/legacy-status.txt" git -C "$LEGACY_ROOT" status --short --branch
  write_command_output "$RUN_DIR/inventory/legacy-worktree.patch" git -C "$LEGACY_ROOT" diff --binary
  write_command_output "$RUN_DIR/inventory/legacy-index.patch" git -C "$LEGACY_ROOT" diff --cached --binary
  write_command_output "$RUN_DIR/inventory/legacy-untracked.txt" git -C "$LEGACY_ROOT" ls-files --others --exclude-standard

  git -C "$LEGACY_ROOT" ls-files --others --ignored --exclude-standard -z 2>/dev/null |
    while IFS= read -r -d '' path; do
      local_path="$LEGACY_ROOT/$path"
      size=$(du -sb -- "$local_path" 2>/dev/null | cut -f1 || printf '0')
      printf '%s\t%s\n' "$size" "$path"
    done >"$RUN_DIR/inventory/legacy-ignored.tsv"
  awk -F '\t' '{ count += 1; bytes += $1 } END { printf "paths=%d\nbytes=%d\n", count, bytes }' \
    "$RUN_DIR/inventory/legacy-ignored.tsv" >"$RUN_DIR/inventory/legacy-ignored-summary.txt"
}

write_inventory() {
  local path target

  mkdir -p "$RUN_DIR/inventory" "$RUN_DIR/phases" "$RUN_DIR/downloads"
  chmod 700 "$RUN_DIR" "$RUN_DIR/inventory" "$RUN_DIR/phases" "$RUN_DIR/downloads"
  {
    printf 'created=%s\n' "$(date --iso-8601=seconds)"
    printf 'user=%s\n' "$USER"
    printf 'host=%s\n' "$(hostname)"
    printf 'shell=%s\n' "${SHELL:-unknown}"
    printf 'legacy_root=%s\n' "$LEGACY_ROOT"
    printf 'pondhouse_package=%s\n' "$PACKAGE_VERSION"
  } >"$RUN_DIR/inventory/system.txt"

  write_git_inventory
  write_command_output "$RUN_DIR/inventory/packages-all.txt" pacman -Q
  write_command_output "$RUN_DIR/inventory/packages-explicit.txt" pacman -Qqe
  write_command_output "$RUN_DIR/inventory/packages-foreign.txt" pacman -Qqm
  write_command_output "$RUN_DIR/inventory/system-services-enabled.txt" systemctl list-unit-files --state=enabled --no-legend
  write_command_output "$RUN_DIR/inventory/system-services.txt" systemctl list-units --type=service --all --no-legend
  write_command_output "$RUN_DIR/inventory/user-services-enabled.txt" systemctl --user list-unit-files --state=enabled --no-legend
  write_command_output "$RUN_DIR/inventory/user-services.txt" systemctl --user list-units --type=service --all --no-legend
  write_command_output "$RUN_DIR/inventory/default-browser.txt" env -u BROWSER xdg-settings get default-web-browser
  sed -n 's/^export EDITOR=//p' "$HOME/.config/uwsm/default" 2>/dev/null | head -n1 \
    >"$RUN_DIR/inventory/default-editor.txt" || true
  [[ ! -f $HOME/.config/mimeapps.list ]] || \
    cp -a "$HOME/.config/mimeapps.list" "$RUN_DIR/inventory/mimeapps.list"
  write_command_output "$RUN_DIR/inventory/default-applications.txt" find "$HOME/.local/share/applications" -maxdepth 1 -type f -printf '%f\n'
  write_command_output "$RUN_DIR/inventory/onboarding-state.txt" find "$HOME/.local/state/omarchy" "$HOME/.config/omarchy" -maxdepth 3 -type f -printf '%p\t%s bytes\n'

  while IFS= read -r -d '' path; do
    target=$(readlink -- "$path")
    printf '%s\t%s\t%s\n' "$path" "$target" "$(readlink -f -- "$path")"
  done < <(find_legacy_links) >"$RUN_DIR/inventory/materialized-links.tsv"
  mark_phase inventory
}

materialization_size() {
  local path size total=0
  while IFS=$'\t' read -r path _; do
    [[ -n $path ]] || continue
    [[ -L $path ]] && points_into_legacy_root "$path" || continue
    size=$(du -sbH -- "$path" 2>/dev/null | cut -f1 || printf '0')
    [[ $size =~ ^[0-9]+$ ]] && total=$((total + size))
  done <"$RUN_DIR/inventory/materialized-links.tsv"
  printf '%s\n' "$total"
}

preservation_size() {
  local backup_dir path size total
  backup_dir=$(<"$RUN_DIR/inventory/backup-path")
  total=$(materialization_size)
  if [[ ! -d $backup_dir ]]; then
    for path in "$LEGACY_ROOT" "$RUN_DIR/inventory"; do
      size=$(du -sb -- "$path" 2>/dev/null | cut -f1 || printf '0')
      [[ $size =~ ^[0-9]+$ ]] && total=$((total + size))
    done
    for path in "${PROTECTED_AGENT_PATHS[@]}"; do
      [[ -e $HOME/$path || -L $HOME/$path ]] || continue
      size=$(du -sbH -- "$HOME/$path" 2>/dev/null | cut -f1 || printf '0')
      [[ $size =~ ^[0-9]+$ ]] && total=$((total + size))
    done
  fi
  printf '%s\n' "$total"
}

materialize_link() {
  local path=$1 original source temporary
  original="$path.pondhouse-legacy-link"
  temporary="$path.pondhouse-materialized"

  if [[ ! -L $path ]]; then
    if [[ -e $path ]]; then
      rm -f -- "$original"
      return 0
    elif [[ -L $original && -e $temporary ]]; then
      mv -T -- "$temporary" "$path"
      rm -- "$original"
      return 0
    fi
    return 0
  fi
  points_into_legacy_root "$path" || return 0

  source=$path
  rm -rf -- "$temporary"
  if ! cp -aH --reflink=auto -- "$source" "$temporary"; then
    rm -rf -- "$temporary"
    echo "Failed to copy $path; the original link is unchanged" >&2
    return 1
  fi
  mv -T -- "$path" "$original"
  if ! mv -T -- "$temporary" "$path"; then
    mv -T -- "$original" "$path"
    return 1
  fi
  rm -- "$original"
}

preserve_and_materialize() {
  local available backup_dir partial_backup required reserve path
  backup_dir=$(<"$RUN_DIR/inventory/backup-path")
  required=$(preservation_size)
  available=$(df --output=avail -B1 "$HOME" | tail -n1 | tr -d ' ')
  reserve=$((2 * 1024 * 1024 * 1024))
  if (( available < required + reserve )); then
    echo "Not enough free space to materialize links and retain a 2 GiB safety margin" >&2
    exit 1
  fi

  if [[ ! -d $backup_dir ]]; then
    partial_backup="$backup_dir.partial"
    rm -rf -- "$partial_backup"
    mkdir -p "$(dirname -- "$backup_dir")"
    mkdir "$partial_backup"
    cp -a --reflink=auto "$LEGACY_ROOT" "$partial_backup/legacy-checkout"
    cp -a "$RUN_DIR/inventory" "$partial_backup/inventory"
    mkdir "$partial_backup/protected-home"
    for path in "${PROTECTED_AGENT_PATHS[@]}"; do
      if [[ -e $HOME/$path || -L $HOME/$path ]]; then
        printf '%s\tpresent\n' "$path" >>"$partial_backup/protected-home.tsv"
        cp -a "$HOME/$path" "$partial_backup/protected-home/$path"
      else
        printf '%s\tabsent\n' "$path" >>"$partial_backup/protected-home.tsv"
      fi
    done
    mv "$partial_backup" "$backup_dir"
  fi
  while IFS=$'\t' read -r path _; do
    [[ -n $path ]] || continue
    echo "Materializing $path"
    materialize_link "$path"
  done < <(awk -F '\t' '{ print length($1) "\t" $0 }' "$RUN_DIR/inventory/materialized-links.tsv" | sort -n | cut -f2-)
  mark_phase preservation
}

stage_upgrader() {
  local destination=$1
  if [[ -n ${PONDHOUSE_UPGRADER_FILE:-} ]]; then
    cp "$PONDHOUSE_UPGRADER_FILE" "$destination"
    printf '%s  %s\n' "$UPGRADER_SHA256" "$destination" | sha256sum -c - >/dev/null
  else
    download_verified "$UPGRADER_URL" "$destination" "$UPGRADER_SHA256" 0
  fi
  chmod 700 "$destination"
}

run_upstream_upgrade() {
  local upgrader="$RUN_DIR/downloads/omarchy-upgrade-to-quattro"
  local no_reboot_bin="$RUN_DIR/downloads/no-reboot-bin"
  stage_upgrader "$upgrader"
  mkdir -p "$no_reboot_bin"
  cat >"$no_reboot_bin/gum" <<'EOF'
#!/bin/bash
if [[ ${1:-} == "confirm" && ${2:-} == "Reboot to complete Quattro upgrade now?" ]]; then
  exit 1
fi
exec /usr/bin/gum "$@"
EOF
  chmod 700 "$no_reboot_bin/gum"
  touch "$RUN_DIR/phases/upstream-attempted"
  rm -f "$RUN_DIR/phases/protected-agent-state"
  echo "Running the checksum-pinned Basecamp Quattro upgrader"
  if ! PATH="$no_reboot_bin:$PATH" PONDHOUSE_QUATTRO_ROOT="$QUATTRO_ROOT" \
    "$upgrader" --yes --channel stable; then
    restore_protected_agent_state
    return 1
  fi
  mark_phase upstream-upgrade
}

restore_protected_agent_state() {
  local backup_dir displaced path status temporary
  backup_dir=$(<"$RUN_DIR/inventory/backup-path")

  while IFS=$'\t' read -r path status; do
    if [[ $status == "absent" ]]; then
      rm -rf -- "$HOME/$path" "$HOME/$path.pondhouse-upgrader-state" \
        "$HOME/$path.pondhouse-restore"
      continue
    fi

    temporary="$HOME/$path.pondhouse-restore"
    displaced="$HOME/$path.pondhouse-upgrader-state"
    rm -rf -- "$temporary" "$displaced"
    cp -a "$backup_dir/protected-home/$path" "$temporary"
    if [[ -e $HOME/$path || -L $HOME/$path ]]; then
      mv -T -- "$HOME/$path" "$displaced"
    fi
    mv -T -- "$temporary" "$HOME/$path"
    rm -rf -- "$displaced"
  done <"$backup_dir/protected-home.tsv"
  mark_phase protected-agent-state
}

download_verified() {
  local url=$1 destination=$2 checksum=$3 signature=${4:-1}
  curl -fsSL --retry 3 "$url" -o "$destination"
  printf '%s  %s\n' "$checksum" "$destination" | sha256sum -c - >/dev/null
  (( signature )) && curl -fsSL --retry 3 "$url.sig" -o "$destination.sig"
}

key_primary_fingerprint() {
  gpg --batch --show-keys --with-colons "$1" 2>/dev/null |
    awk -F: '$1 == "pub" { primary = 1; next } primary && $1 == "fpr" { print $10; exit }'
}

verify_signing_key() {
  local key=$1 fingerprint
  fingerprint=$(key_primary_fingerprint "$key")
  [[ $fingerprint == "$SIGNING_FINGERPRINT" ]] || {
    echo "Pondhouse signing fingerprint mismatch: ${fingerprint:-missing}" >&2
    return 1
  }
  if gpg --batch --show-keys --with-colons "$key" 2>/dev/null | grep -Eq '^(sec|ssb):'; then
    echo "Pondhouse trust payload unexpectedly contains private key material" >&2
    return 1
  fi
}

preflight_pondhouse_release() {
  local keyring="$RUN_DIR/downloads/pondhouse-keyring-$KEYRING_VERSION-any.pkg.tar.zst"
  local package="$RUN_DIR/downloads/pondhouse-omarchy-$PACKAGE_VERSION-x86_64.pkg.tar.zst"
  local repository="$RUN_DIR/downloads/pondhouse.db.tar.gz"
  local trust_dir="$RUN_DIR/downloads/pondhouse-trust"
  local public_key="$trust_dir/usr/share/pacman/keyrings/pondhouse.gpg"

  if phase_done release-preflight; then
    printf '%s  %s\n' "$KEYRING_SHA256" "$keyring" | sha256sum -c - >/dev/null
    printf '%s  %s\n' "$PACKAGE_SHA256" "$package" | sha256sum -c - >/dev/null
    printf '%s  %s\n' "$REPOSITORY_SHA256" "$repository" | sha256sum -c - >/dev/null
  else
    download_verified "$SNAPSHOT_URL/${keyring##*/}" "$keyring" "$KEYRING_SHA256"
    download_verified "$SNAPSHOT_URL/${package##*/}" "$package" "$PACKAGE_SHA256"
    download_verified "$SNAPSHOT_URL/${repository##*/}" "$repository" "$REPOSITORY_SHA256"
  fi
  rm -rf "$trust_dir"
  mkdir -p "$(dirname "$public_key")"
  bsdtar -xOf "$keyring" usr/share/pacman/keyrings/pondhouse.gpg >"$public_key"
  verify_signing_key "$public_key"
  gpgv --keyring "$public_key" "$keyring.sig" "$keyring" >/dev/null
  gpgv --keyring "$public_key" "$package.sig" "$package" >/dev/null
  gpgv --keyring "$public_key" "$repository.sig" "$repository" >/dev/null
  mark_phase release-preflight
}

verify_active_pacman_key() {
  local exported
  exported=$(mktemp "$RUN_DIR/downloads/active-pondhouse-key.XXXXXX")
  if ! sudo pacman-key --export "$SIGNING_FINGERPRINT" >"$exported"; then
    rm -f "$exported"
    return 1
  fi
  verify_signing_key "$exported"
  rm -f "$exported"
}

run_pacman_with_required_local_signatures() {
  local strict_config status
  strict_config=$(mktemp "$RUN_DIR/downloads/pacman-required.XXXXXX")
  cp "$PACMAN_CONFIG" "$strict_config"
  if grep -q '^LocalFileSigLevel' "$strict_config"; then
    sed -i 's/^LocalFileSigLevel.*/LocalFileSigLevel = Required/' "$strict_config"
  else
    printf '\nLocalFileSigLevel = Required\n' >>"$strict_config"
  fi

  status=0
  sudo pacman --config "$strict_config" "$@" || status=$?
  rm -f "$strict_config"
  return "$status"
}

verify_keyring_install() {
  local expected="pondhouse-keyring $KEYRING_VERSION"
  [[ $(pacman -Q pondhouse-keyring 2>/dev/null) == $expected ]] &&
    sudo pacman -Qkk pondhouse-keyring >/dev/null &&
    [[ -s $PACMAN_KEYRING_DIR/pondhouse.gpg ]] &&
    [[ -f $PACMAN_KEYRING_DIR/pondhouse-trusted ]] &&
    [[ -f $PACMAN_KEYRING_DIR/pondhouse-revoked ]]
}

verify_pacman_accepts_company_package() {
  local package="$RUN_DIR/downloads/pondhouse-omarchy-$PACKAGE_VERSION-x86_64.pkg.tar.zst"
  run_pacman_with_required_local_signatures -U --noconfirm --downloadonly "$package" >/dev/null
}

establish_pondhouse_trust() {
  local keyring="$RUN_DIR/downloads/pondhouse-keyring-$KEYRING_VERSION-any.pkg.tar.zst"
  local public_key="$RUN_DIR/downloads/pondhouse-trust/usr/share/pacman/keyrings/pondhouse.gpg"

  preflight_pondhouse_release
  sudo pacman-key --add "$public_key"
  sudo pacman-key --lsign-key "$SIGNING_FINGERPRINT"
  verify_active_pacman_key

  if ! verify_keyring_install; then
    run_pacman_with_required_local_signatures -U --noconfirm --needed "$keyring"
  fi
  verify_keyring_install
  sudo pacman-key --populate pondhouse
  verify_active_pacman_key
  verify_pacman_accepts_company_package
  mark_phase pondhouse-trust-ready
}

verify_pondhouse_trust() {
  verify_keyring_install
  verify_active_pacman_key
  verify_pacman_accepts_company_package
}

install_pondhouse_release() {
  local package="$RUN_DIR/downloads/pondhouse-omarchy-$PACKAGE_VERSION-x86_64.pkg.tar.zst"
  local config

  verify_pondhouse_trust

  if ! phase_done company-package-install; then
    run_pacman_with_required_local_signatures -U --noconfirm --needed "$package"
    [[ $(pacman -Q pondhouse-omarchy) == "pondhouse-omarchy $PACKAGE_VERSION" ]]
    mark_phase company-package-install
  fi
  [[ $(pacman -Q pondhouse-omarchy) == "pondhouse-omarchy $PACKAGE_VERSION" ]]

  if ! phase_done stable-repository; then
    config=$(mktemp)
    printf '[pondhouse]\nSigLevel = Required\nServer = %s\n' "$STABLE_URL" >"$config"
    sudo install -Dm644 "$config" /etc/pacman.d/pondhouse.conf
    rm -f "$config"
    if ! grep -Fqx 'Include = /etc/pacman.d/pondhouse.conf' /etc/pacman.conf; then
      printf '\nInclude = /etc/pacman.d/pondhouse.conf\n' | sudo tee -a /etc/pacman.conf >/dev/null
    fi
    mark_phase stable-repository
  fi
  mark_phase package-install
}

reconcile_pondhouse() {
  export PONDHOUSE_LEGACY_CHECKOUT
  PONDHOUSE_LEGACY_CHECKOUT="$(<"$RUN_DIR/inventory/backup-path")/legacy-checkout"
  if ! phase_done required-packages; then
    omarchy-pondhouse-reconcile-packages
    mark_phase required-packages
  fi
  if ! phase_done system-reconciliation; then
    sudo omarchy-pondhouse-reconcile-system
    mark_phase system-reconciliation
  fi
  if ! phase_done user-reconciliation; then
    omarchy-pondhouse-reconcile-user
    mark_phase user-reconciliation
  fi
  if ! phase_done package-integrity; then
    pacman -Qkk pondhouse-omarchy
    mark_phase package-integrity
  fi
  mark_phase reconciliation
}

restore_defaults() {
  local browser editor

  if [[ -s $RUN_DIR/inventory/default-browser.txt ]] && command -v xdg-settings >/dev/null 2>&1; then
    browser=$(<"$RUN_DIR/inventory/default-browser.txt")
    [[ -n $browser ]] && env -u BROWSER xdg-settings set default-web-browser "$browser"
  fi
  if [[ -s $RUN_DIR/inventory/default-editor.txt ]] && command -v omarchy-default-editor >/dev/null 2>&1; then
    editor=$(<"$RUN_DIR/inventory/default-editor.txt")
    editor=${editor#\'}
    editor=${editor%\'}
    editor=${editor#\"}
    editor=${editor%\"}
    editor=${editor%% *}
    [[ $editor == "zed" ]] && editor="zeditor"
    case "$editor" in
      code|cursor|zeditor|sublime_text|helix|vim|emacs|nvim) omarchy-default-editor "$editor" ;;
    esac
  fi
  if [[ -f $RUN_DIR/inventory/mimeapps.list ]]; then
    install -Dm600 "$RUN_DIR/inventory/mimeapps.list" "$HOME/.config/mimeapps.list"
  fi
  mark_phase defaults-restored
}

if [[ -n $RUN_DIR ]]; then
  RUN_DIR=$(readlink -m -- "$RUN_DIR")
  [[ $RUN_DIR == "$STATE_BASE"/* && -f $RUN_DIR/inventory/system.txt ]] || {
    echo "Invalid Pondhouse migration run directory: $RUN_DIR" >&2
    exit 1
  }
else
  mkdir -p "$STATE_BASE"
  timestamp=$(date +%Y%m%d%H%M%S)
  suffix=""
  (( DRY_RUN )) && suffix=-dry-run
  final_run_dir="$STATE_BASE/$timestamp$suffix"
  while [[ -e $final_run_dir ]]; do
    final_run_dir="$STATE_BASE/$timestamp-$RANDOM$suffix"
  done
  RUN_DIR="$STATE_BASE/.${final_run_dir##*/}.initializing.$$"
  mkdir -p "$RUN_DIR"
  write_inventory
  printf '%s\n' "$BACKUP_BASE/${final_run_dir##*/}" >"$RUN_DIR/inventory/backup-path"
  mv "$RUN_DIR" "$final_run_dir"
  RUN_DIR=$final_run_dir
fi

link_count=$(wc -l <"$RUN_DIR/inventory/materialized-links.tsv")
required_bytes=$(preservation_size)
echo "Pondhouse Omarchy 3 to package-backed Quattro migration"
echo "Legacy checkout: $LEGACY_ROOT"
echo "Private migration record: $RUN_DIR"
echo "Checkout-backed links: $link_count"
cut -f1 "$RUN_DIR/inventory/materialized-links.tsv" | sed 's/^/  /'
echo "Estimated preservation space: $(numfmt --to=iec-i --suffix=B "$required_bytes")"
echo "Pinned Pondhouse package: $PACKAGE_VERSION"

if (( DRY_RUN )); then
  echo "Dry run complete. The private inventory was recorded; no machine state changed."
  exit 0
fi

[[ -d $LEGACY_ROOT/.git || -d $QUATTRO_ROOT ]] || {
  echo "Neither the legacy checkout nor Omarchy Quattro was found" >&2
  exit 1
}

if (( ! YES )) && ! gum confirm "Continue with the Pondhouse Quattro migration?"; then
  exit 0
fi

saved_command="$RUN_DIR/pondhouse-upgrade-to-quattro"
if [[ $(readlink -f -- "$0") != $(readlink -f -- "$saved_command" 2>/dev/null || true) ]]; then
  cp "$0" "$saved_command"
fi
chmod 700 "$RUN_DIR/pondhouse-upgrade-to-quattro"
ln -sfn "$RUN_DIR" "$STATE_BASE/latest"
printf -v resume_command '%q --resume %q --yes' "$RUN_DIR/pondhouse-upgrade-to-quattro" "$RUN_DIR"
trap 'status=$?; if (( status != 0 )); then printf "\nMigration is incomplete. Do not reboot. Resume with:\n  %s\n" "$resume_command" >&2; fi; exit "$status"' EXIT

preflight_pondhouse_release
phase_done preservation || preserve_and_materialize
if phase_done upstream-upgrade; then
  verify_pondhouse_trust
else
  establish_pondhouse_trust
fi
phase_done upstream-upgrade || run_upstream_upgrade
phase_done protected-agent-state || restore_protected_agent_state
verify_pondhouse_trust
phase_done package-install || install_pondhouse_release
phase_done reconciliation || reconcile_pondhouse
phase_done defaults-restored || restore_defaults
mark_phase complete
trap - EXIT

cat <<EOF

Pondhouse Quattro migration completed.
Migration records: $RUN_DIR
Permanent checkout backup: $(<"$RUN_DIR/inventory/backup-path")

Reboot when ready, then run omarchy-pondhouse-parity.
EOF
