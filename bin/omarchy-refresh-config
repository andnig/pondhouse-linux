#!/bin/bash

# omarchy:summary=Ensure the named Omarchy config is available through the symlink-based ~/.config install.
# omarchy:args=<config-path>

set -uo pipefail

show_usage() {
  cat <<USAGE
Usage: $0 [config_file]

Must provide a file path from the .config directory to be refreshed.
To make ~/.local/share/omarchy/config/hypr/hyprlock.conf available at
~/.config/hypr/hyprlock.conf:

  $0 hypr/hyprlock.conf
USAGE
}

style() {
  local color=$1
  local message=$2

  if [[ -t 1 ]] && command -v gum >/dev/null 2>&1; then
    gum style --foreground "$color" "$message"
  else
    echo "$message"
  fi
}

warn() {
  local title=$1
  shift

  if [[ -t 1 ]] && command -v gum >/dev/null 2>&1; then
    gum style --border rounded --border-foreground 3 --padding "0 2" --foreground 3 "$title" "$@"
  else
    echo "WARNING: $title"
    for line in "$@"; do
      echo "  $line"
    done
  fi
}

config_file=${1:-}

if [[ -z $config_file ]]; then
  show_usage >&2
  exit 1
fi

# Strip leading slashes so callers cannot escape ~/.config or config/ by
# accidentally passing an absolute path.
config_file=${config_file#/}
config_entry=${config_file%%/*}

source_entry="$HOME/.local/share/omarchy/config/$config_entry"
target_entry="$HOME/.config/$config_entry"

if [[ ! -e $source_entry && ! -L $source_entry ]]; then
  warn "Omarchy config source missing" \
    "Requested: $config_file" \
    "Expected source: $source_entry" \
    "Nothing was changed."
  exit 0
fi

mkdir -p "$HOME/.config"

if [[ -L $target_entry ]]; then
  current_target=$(readlink "$target_entry")

  if [[ $current_target == "$source_entry" ]]; then
    style 2 "Omarchy config already symlinked: ~/.config/$config_entry"
    exit 0
  fi

  ln -sfn "$source_entry" "$target_entry"
  style 2 "Updated Omarchy config symlink: ~/.config/$config_entry -> $source_entry"
  exit 0
fi

if [[ -e $target_entry ]]; then
  warn "Cannot symlink Omarchy config" \
    "Requested: $config_file" \
    "Target already exists and is not a symlink: $target_entry" \
    "Expected symlink target: $source_entry" \
    "Leaving existing file/directory untouched."
  exit 0
fi

ln -sfn "$source_entry" "$target_entry"
style 2 "Created Omarchy config symlink: ~/.config/$config_entry -> $source_entry"
