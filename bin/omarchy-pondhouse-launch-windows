#!/bin/bash

# Function to show loading indicator
show_loading() {
  local duration=$1
  local spinner='|/-\'
  local end_time=$((SECONDS + duration))
  local message="${2:-Starting Windows container and waiting for connection}"

  echo -n "$message"
  while [ $SECONDS -lt $end_time ]; do
    for i in $(seq 0 3); do
      if [ $SECONDS -ge $end_time ]; then
        break 2
      fi
      echo -ne "\r$message ${spinner:$i:1}"
      sleep 0.25
    done
  done
  echo -e "\r$message... Done!"
}

# Check if Windows has been installed before
INSTALL_MARKER="$HOME/.local/state/omarchy/windows-installed"
INSTALL_MARKER_DIR="$HOME/.local/state/omarchy"

# Start Docker Compose
echo "Starting Windows container..."
docker compose --file $HOME/.config/windows/compose.yml up -d

# Check if Docker Compose started successfully
if [ $? -eq 0 ]; then
  echo "Docker Compose started successfully!"

  # Check if this is first time setup
  if [ ! -f "$INSTALL_MARKER" ]; then
    echo "=================================================="
    echo "FIRST TIME SETUP DETECTED"
    echo "=================================================="
    echo ""
    echo "This is the first time running the Windows VM."
    echo "A browser window will open showing the installation process."
    echo ""
    echo -e "\033[1;31mIMPORTANT: Please wait until the installation is complete,"
    echo -e "then run this Windows program again.\033[0m"
    echo ""
    echo "=================================================="

    # Wait 10 seconds with loading indicator
    show_loading 10 "Opening browser in"

    # Open browser to localhost:8006
    echo "Opening browser to monitor installation..."

    # Try different commands to open browser (cross-platform compatibility)
    if command -v xdg-open >/dev/null; then
      xdg-open http://localhost:8006
    elif command -v open >/dev/null; then
      open http://localhost:8006
    elif command -v sensible-browser >/dev/null; then
      sensible-browser http://localhost:8006
    else
      echo "Could not auto-open browser. Please manually navigate to: http://localhost:8006"
    fi

    # Create the marker directory if it doesn't exist
    mkdir -p "$INSTALL_MARKER_DIR"

    # Create the marker file
    touch "$INSTALL_MARKER"
    echo "Installation marker created at: $INSTALL_MARKER"

  else
    # Normal execution - Windows already installed
    # Show loading indicator for 5 seconds
    show_loading 5

    # Connect with Remmina
    echo "Connecting to Windows via RDP..."
    remmina -c rdp://MyWindowsUser:MyWindowsPassword@127.0.0.1
  fi

else
  echo "Error: Failed to start Docker Compose"
  exit 1
fi
