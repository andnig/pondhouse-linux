# Database connection
dbconnect() {
  local envfile=".env"
  local script=""

  # Help function
  _dbconnect_help() {
    cat <<EOF
Usage: dbconnect [OPTIONS]

Connect to a PostgreSQL database using DATABASE_URL from an env file.

Options:
  -e, --env FILE    Env file to read (default: .env)
  -f, --file FILE   SQL script to execute
  -h, --help        Show this help message

Examples:
  dbconnect                           # interactive, uses .env
  dbconnect -f migrate.sql            # runs script, uses .env
  dbconnect -e .env.prod              # interactive, uses .env.prod
  dbconnect -e .env.prod -f seed.sql  # runs script with specific env
EOF
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e|--env) envfile="$2"; shift 2 ;;
      -f|--file) script="$2"; shift 2 ;;
      -h|--help) _dbconnect_help; return 0 ;;
      *) echo "Unknown option: $1" >&2; _dbconnect_help >&2; return 1 ;;
    esac
  done

  [[ -f "$envfile" ]] || { echo "File not found: $envfile" >&2; return 1; }
  local url=$(grep -E '^DATABASE_URL=' "$envfile" | cut -d '=' -f2- | tr -d '"'"'")
  [[ -n "$url" ]] || { echo "DATABASE_URL not found in $envfile" >&2; return 1; }

  if [[ -n "$script" ]]; then
    [[ -f "$script" ]] || { echo "Script not found: $script" >&2; return 1; }
    psql "$url" -f "$script"
  else
    psql "$url"
  fi
}

