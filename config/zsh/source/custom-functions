# Compression but zip
zip_compress() {
  local output=""
  local inputs=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output) output="$2"; shift 2 ;;
      *) inputs+=("$1"); shift ;;
    esac
  done

  if [ ${#inputs[@]} -eq 0 ]; then
    echo "Usage: zip_compress [-o output.zip] <file_or_folder> [file_or_folder ...]"
    return 1
  fi

  [ -z "$output" ] && output="${inputs[0]%/}.zip"
  zip -r "$output" "${inputs[@]}"
}
zip_decompress() {
  if [ $# -eq 0 ]; then
    echo "Usage: zip_decompress <zip_file>"
    return 1
  fi
  local zip_file="$1"
  unzip "$zip_file"
}

# Write iso file to sd card
iso2sd() {
  if [ $# -ne 2 ]; then
    echo "Usage: iso2sd <input_file> <output_device>"
    echo "Example: iso2sd ~/Downloads/ubuntu-25.04-desktop-amd64.iso /dev/sda"
    echo -e "\nAvailable SD cards:"
    lsblk -d -o NAME | grep -E '^sd[a-z]' | awk '{print "/dev/"$1}'
  else
    sudo dd bs=4M status=progress oflag=sync if="$1" of="$2"
    sudo eject $2
  fi
}

# copy file to clipboard via wl-clipboard
cpfile() {
  local files=()
  for file in "$@"; do
    files+=("file://$(realpath "$file")")
  done
  printf '%s\n' "${files[@]}" | wl-copy -t text/uri-list
}

# Database connection
dbconnect() {
  local envfile=".env"
  local script=""

  # Help function
  _dbconnect_help() {
    cat <<EOF
Usage: dbconnect [OPTIONS]

Connect to a PostgreSQL database using DATABASE_URL from an env file.

Options:
  -e, --env FILE    Env file to read (default: .env)
  -f, --file FILE   SQL script to execute
  -h, --help        Show this help message

Examples:
  dbconnect                           # interactive, uses .env
  dbconnect -f migrate.sql            # runs script, uses .env
  dbconnect -e .env.prod              # interactive, uses .env.prod
  dbconnect -e .env.prod -f seed.sql  # runs script with specific env
EOF
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e|--env) envfile="$2"; shift 2 ;;
      -f|--file) script="$2"; shift 2 ;;
      -h|--help) _dbconnect_help; return 0 ;;
      *) echo "Unknown option: $1" >&2; _dbconnect_help >&2; return 1 ;;
    esac
  done

  [[ -f "$envfile" ]] || { echo "File not found: $envfile" >&2; return 1; }
  local url=$(grep -E '^DATABASE_URL=' "$envfile" | cut -d '=' -f2- | tr -d '"'"'")
  [[ -n "$url" ]] || { echo "DATABASE_URL not found in $envfile" >&2; return 1; }

  if [[ -n "$script" ]]; then
    [[ -f "$script" ]] || { echo "Script not found: $script" >&2; return 1; }
    psql "$url" -f "$script"
  else
    psql "$url"
  fi
}

