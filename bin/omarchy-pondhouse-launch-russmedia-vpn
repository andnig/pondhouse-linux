#!/bin/bash

# Run setup tasks with elevated privileges (single prompt)
# This handles: creating profile directory, profile file, and starting service
pkexec omarchy-pondhouse-init-russmedia-vpn-helper

# Launch Cisco Secure Client UI (as regular user)
echo "Launching Cisco Secure Client UI..."
env GDK_BACKEND=x11 MOZ_ENABLE_WAYLAND=0 WEBKIT_DISABLE_DMABUF_RENDERER=1 cisco-secure-client
