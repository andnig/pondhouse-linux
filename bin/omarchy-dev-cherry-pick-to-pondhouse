#!/bin/bash

set -e

branch=$(git -C $OMARCHY_PATH branch --show-current)

# Fetch latest pondhouse state
git -C $OMARCHY_PATH fetch pondhouse

# Find commits unique to this custom fork (not in pondhouse, no merges)
mapfile -t shas < <(git -C $OMARCHY_PATH log --no-merges --format="%H" pondhouse/$branch..HEAD)
mapfile -t labels < <(git -C $OMARCHY_PATH log --no-merges --format="%h %s" pondhouse/$branch..HEAD)

if (( ${#shas[@]} == 0 )); then
  echo "No custom commits to cherry-pick."
  exit 0
fi

# Let user pick commits (newest on top)
mapfile -t picked < <(printf "%s\n" "${labels[@]}" | gum choose --no-limit --header "Select commits to push to pondhouse (space to select, enter to confirm):")

if (( ${#picked[@]} == 0 )); then
  echo "No commits selected."
  exit 0
fi

# Map selected labels back to full SHAs
selected_shas=()
for pick in "${picked[@]}"; do
  short_sha=${pick%% *}
  for i in "${!labels[@]}"; do
    if [[ ${labels[$i]} == $pick ]]; then
      selected_shas+=("${shas[$i]}")
      break
    fi
  done
done

echo ""
echo "Selected ${#selected_shas[@]} commit(s):"
for pick in "${picked[@]}"; do
  echo "  $pick"
done
echo ""

if ! gum confirm "Cherry-pick these to pondhouse/$branch and push?"; then
  echo "Cancelled."
  exit 0
fi

# Cherry-pick in chronological order in an isolated worktree so the user's
# main checkout (including any uncommitted changes) is never touched.
mapfile -t ordered < <(printf "%s\n" "${selected_shas[@]}" | tac)

worktree_dir=$(mktemp -d -t omarchy-pondhouse-XXXXXX)
cleanup_worktree() {
  git -C $OMARCHY_PATH worktree remove --force "$worktree_dir" 2>/dev/null || rm -rf "$worktree_dir"
}
trap cleanup_worktree EXIT

git -C $OMARCHY_PATH worktree add --detach "$worktree_dir" "pondhouse/$branch" >/dev/null

remaining=${#ordered[@]}
for sha in "${ordered[@]}"; do
  if ! git -C "$worktree_dir" cherry-pick "$sha"; then
    short=$(git -C $OMARCHY_PATH log -1 --format="%h %s" "$sha")
    ((remaining--))
    # Keep the worktree alive so the user can finish the cherry-pick manually.
    trap - EXIT
    echo ""
    echo -e "\e[33mCherry-pick conflict on: $short\e[0m"
    echo ""
    echo "Resolve conflicts in the isolated worktree, then continue:"
    echo ""
    echo "  cd $worktree_dir"
    echo "  # fix conflicting files, then:"
    echo "  git add <resolved files>"
    echo "  git cherry-pick --continue"
    if (( remaining > 0 )); then
      echo ""
      echo "  # remaining $remaining commit(s) to cherry-pick after this one:"
      for remaining_sha in "${ordered[@]:$(( ${#ordered[@]} - remaining ))}"; do
        echo "    $(git -C $OMARCHY_PATH log -1 --format='%h %s' "$remaining_sha")"
      done
      echo ""
      echo "  # cherry-pick them one by one with: git cherry-pick <sha>"
    fi
    echo ""
    echo "When all cherry-picks are done, push and clean up:"
    echo ""
    echo "  git -C $worktree_dir push pondhouse HEAD:$branch"
    echo "  git -C $OMARCHY_PATH worktree remove --force $worktree_dir"
    echo ""
    echo "To abort everything:"
    echo ""
    echo "  git -C $worktree_dir cherry-pick --abort"
    echo "  git -C $OMARCHY_PATH worktree remove --force $worktree_dir"
    echo ""
    echo "Your main checkout at $OMARCHY_PATH was not touched."
    exit 1
  fi
done

git -C "$worktree_dir" push pondhouse HEAD:$branch
# trap removes the worktree on EXIT

echo ""
echo -e "\e[32mDone. ${#selected_shas[@]} commit(s) pushed to pondhouse/$branch.\e[0m"
